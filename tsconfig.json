{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@dream-machine/witness": ["./packages/witness/src/index.ts"],
      "@dream-machine/ledger": ["./packages/ledger/src/index.ts"],
      "@dream-machine/compile": ["./packages/compile/src/index.ts"],
      "@dream-machine/schedule": ["./packages/schedule/src/index.ts"],
      "@dream-machine/memory": ["./packages/memory/src/index.ts"],
      "@dream-machine/edge-contracts": ["./packages/edge-contracts/src/index.ts"],
      "@dream-machine/edge-sim": ["./packages/edge-sim/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "packages/*/dist"]
}
