{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruv.net/dream-machine/schemas/edge-v1/cue-proposal.schema.json",
  "title": "Dream Machine CueProposalV1 JSON representation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "proposalId",
    "profileId",
    "experimentId",
    "modality",
    "assetSha256",
    "intensityQ15",
    "durationMs",
    "rampMs",
    "earliestMonotonicUs",
    "latestMonotonicUs",
    "stateDigest",
    "signalConfidenceQ15",
    "objective",
    "reasonCode",
    "modelDigest",
    "createdBy",
    "authority"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "proposalId": { "$ref": "#/$defs/id128" },
    "profileId": { "$ref": "#/$defs/safeId" },
    "experimentId": { "$ref": "#/$defs/id128" },
    "modality": { "enum": ["audio", "light", "haptic"] },
    "assetSha256": { "$ref": "#/$defs/sha256" },
    "intensityQ15": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32767
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    },
    "rampMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "earliestMonotonicUs": { "$ref": "#/$defs/uint64" },
    "latestMonotonicUs": { "$ref": "#/$defs/uint64" },
    "stateDigest": { "$ref": "#/$defs/sha256" },
    "signalConfidenceQ15": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32767
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reasonCode": { "$ref": "#/$defs/safeId" },
    "modelDigest": { "$ref": "#/$defs/sha256" },
    "createdBy": { "$ref": "#/$defs/safeId" },
    "authority": { "const": "none" }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+(?![\\s\\S])"
    },
    "id128": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^(?!0{32}$)[a-f0-9]{32}(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "uint64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])(?![\\s\\S])"
    }
  }
}
