{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruv.net/dream-machine/schemas/edge-v1/observation.schema.json",
  "title": "Dream Machine SignalFrameV1 JSON representation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceId",
    "sourceKind",
    "bootId",
    "sequence",
    "observedAt",
    "sourceMonotonicUs",
    "ingestedMonotonicUs",
    "clockUncertaintyMs",
    "qualityQ15",
    "flags",
    "values",
    "evidenceLevel",
    "privacyClass",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceId": { "$ref": "#/$defs/safeId" },
    "sourceKind": {
      "enum": ["mr60bha2", "esp32_csi", "ambient", "watch"]
    },
    "bootId": { "$ref": "#/$defs/id128" },
    "sequence": { "$ref": "#/$defs/uint64" },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z(?![\\s\\S])"
    },
    "sourceMonotonicUs": { "$ref": "#/$defs/uint64" },
    "ingestedMonotonicUs": { "$ref": "#/$defs/uint64" },
    "clockUncertaintyMs": {
      "type": "number",
      "minimum": 0,
      "maximum": 600000
    },
    "qualityQ15": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32767
    },
    "flags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "no_presence",
          "out_of_geometry",
          "low_snr",
          "interference",
          "packet_loss",
          "clock_uncertain",
          "sensor_warmup",
          "stale",
          "restarted",
          "calibration_needed",
          "multiple_subjects",
          "source_fault"
        ]
      }
    },
    "values": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "$ref": "#/$defs/safeId" },
      "additionalProperties": {
        "oneOf": [
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" }
        ]
      }
    },
    "evidenceLevel": {
      "enum": [
        "simulated",
        "transport_verified",
        "fixture_measured",
        "human_reference_measured",
        "promoted"
      ]
    },
    "privacyClass": { "enum": ["P0", "P1", "P2", "P3"] },
    "rawRef": {
      "type": "string",
      "minLength": 94,
      "maxLength": 94,
      "pattern": "^urn:dream-machine:calibration:[a-f0-9]{64}(?![\\s\\S])"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "adapterVersion", "calibrationId", "inputDigest"],
      "properties": {
        "adapter": { "$ref": "#/$defs/safeId" },
        "adapterVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "calibrationId": { "$ref": "#/$defs/safeId" },
        "inputDigest": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+(?![\\s\\S])"
    },
    "id128": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^(?!0{32}$)[a-f0-9]{32}(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "uint64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])(?![\\s\\S])"
    }
  }
}
