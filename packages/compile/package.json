{
  "name": "@dream-machine/compile",
  "version": "0.1.0",
  "description": "Compile a dream.config into the full Dream Machine nightly routine prompt \u2014 one source, many target repos.",
  "type": "module",
  "license": "MIT",
  "author": "rUv <ruv@ruv.net>",
  "homepage": "https://github.com/ruvnet/dream-machine",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/dream-machine.git",
    "directory": "packages/compile"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./optimizer": {
      "types": "./dist/harness-optimizer.d.ts",
      "import": "./dist/harness-optimizer.js"
    },
    "./rule-learning": {
      "types": "./dist/rule-learning.d.ts",
      "import": "./dist/rule-learning.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "keywords": [
    "dream-machine",
    "prompt-compiler",
    "config",
    "routine"
  ]
}
